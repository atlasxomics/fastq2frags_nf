manifest {
    name            = 'atlasxomics/fastq2frags_nf'
    description     = 'AtlasXomics epigenomic preprocessing (fastq2frags) for DBiT-seq'
    homePage        = 'https://github.com/atlasxomics/fastq2frags_nf'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = new File("${projectDir}/version").text.trim()
}

params {
    // Input: either a samplesheet (run_id,r1,r2[,ng_id][,ds_table]) or a single sample
    input                = null
    run_id               = null
    r1                   = null
    r2                   = null

    // Reference
    genome_dir           = null        // directory with the Chromap *.fa and *.index
    genome_id            = null        // inferred from the *.fa name when unset (GRCh38, GRCm38, GRCm39, Rnor6, mm10, mm39)
    barcode_file         = 'bc220_25-APR.txt'  // name in barcodes/ or a path
    positions_file       = null        // defaults to the positions list matching barcode_file

    // Read filtering
    skip_linker1         = false
    skip_linker2         = false
    bulk                 = false
    no_ligation_bulk     = false

    // Fragment processing
    blacklist_filtering  = true
    ds_table             = null        // correction table for cleaning / cross-talk correction
    cleaning             = false
    xtalk_correction     = false
    xtalk_threshold      = 2.0

    // Metrics
    min_fragments        = 100         // FRiP + per-cell metrics on barcodes with >= this many fragments
    input_fragment_floor = 1           // peaks + bigwig on barcodes with >= this many fragments

    // SLIMS (credentials: `nextflow secrets set SLIMS_USERNAME ...` / SLIMS_PASSWORD)
    upload_to_slims      = false
    ng_id                = 'NG00000'

    // Output
    outdir               = 'results'
    publish_dir_mode     = 'copy'

    container            = ''          // defaults to atx-fastq2frags:<version>
}

process {
    // Closure is also evaluated at session start, before script params are bound.
    container     = { params.containsKey('container') && params.container ? params.container : "atx-fastq2frags:${workflow.manifest.version}" }
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    // Log the EC2 instance each task runs on to the task's stderr (.command.err,
    // CloudWatch, Seqera's task view), so runs can be compared later. Uses the
    // instance metadata service (IMDSv2, falling back to v1); prints nothing
    // where there is none, e.g. local runs.
    beforeScript  = '''
        nxf_imds() {
            local token
            token=$(curl -sf -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token 2>/dev/null) || true
            curl -sf -m 2 ${token:+-H "X-aws-ec2-metadata-token: $token"} "http://169.254.169.254/latest/meta-data/$1" 2>/dev/null
        }
        if nxf_type=$(nxf_imds instance-type); then
            echo "[ec2] instance_type=$nxf_type instance_id=$(nxf_imds instance-id || true) zone=$(nxf_imds placement/availability-zone || true) lifecycle=$(nxf_imds instance-life-cycle || true)" >&2
        fi
        '''.stripIndent()

    withLabel: process_single  { cpus = 1;  memory = 2.GB }
    withLabel: process_medium  { cpus = 8;  memory = 32.GB }
    withLabel: process_metrics { cpus = 16; memory = 64.GB }
    withLabel: process_high    { cpus = 42; memory = 192.GB }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    // Small machine / CI: cap every process to the local resources.
    test {
        process.resourceLimits = [cpus: 4, memory: 12.GB]
    }
    // Laptop test runs (e.g. 16 GB Apple Silicon with Docker Desktop at ~12 GB).
    // Needs an image built with a small Chromap sort buffer; see README.
    local {
        process.resourceLimits = [cpus: 4, memory: 10.GB]
    }
    // AWS Batch dev environment from infra/aws-batch-dev.cfn.yml. Pass the
    // S3 work dir with -w and an ECR image with --container. Combine with
    // `test` to cap tasks at 4 CPU / 12 GB (use the -local image for that).
    // No resourceLimits here: profiles apply in the order they are defined in
    // this file, so a cap here would override the one in `test`.
    // Don't set aws.batch.cliPath: it mounts that directory from the host over
    // the container's (hiding the image's own CLI). Without it Nextflow runs
    // the `aws` on the image's PATH.
    awsbatch {
        process.executor  = 'awsbatch'
        process.queue     = 'atx-fastq2frags-dev'
        aws.region        = 'us-east-1'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
